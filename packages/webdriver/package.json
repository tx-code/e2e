{
  "name": "@e2e-dev/webdriver",
  "version": "0.1.0",
  "description": "WebDriver engine for e2e",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./windows": {
      "types": "./dist/windows.d.ts",
      "default": "./dist/windows.js"
    },
    "./annotations": {
      "types": "./dist/annotations.d.ts",
      "default": "./dist/annotations.js"
    },
    "./acceptance": {
      "types": "./dist/acceptance.d.ts",
      "default": "./dist/acceptance.js"
    }
  },
  "files": [
    "dist",
    "native",
    "NOTICE"
  ],
  "bin": { "e2e-acceptance": "./dist/acceptance-cli.js" },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node ../../scripts/stamp-dist.ts",
    "prepublishOnly": "node ../../scripts/check-dist.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "selenium-webdriver": "4.48.0",
    "sharp": "0.35.4",
    "zod": "4.6.1"
  },
  "peerDependencies": {
    "e2e": ">=0.19.0 <1"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/selenium-webdriver": "^4.35.0",
    "e2e": "workspace:*",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": "^22.22.3 || >=24.8.0"
  }
}
